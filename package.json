{
  "name": "living-world",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "start": "npm run ui:build && node server/index.js",
    "ui:build": "next build ui",
    "test": "npm run ui:build && node scripts/test.js",
    "backup": "node scripts/backup.js",
    "steward:status": "node scripts/steward-status.js",
    "steward:once": "node scripts/steward-status.js --once",
    "admin:open": "node scripts/admin-open.js",
    "admin:prepare": "node scripts/admin-open.js --prepare",
    "godot:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/godot-check.ps1",
    "contracts:check": "node scripts/validate-contracts.js",
    "lab:admin": "npm run ui:build && node scripts/admin-browser-lab.js",
    "lab:micro": "npm run ui:build && node scripts/micro-world-lab.js",
    "lab:full": "npm test && npm run lab:micro"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.140",
    "@radix-ui/react-use-controllable-state": "latest",
    "@streamdown/cjk": "latest",
    "@streamdown/code": "latest",
    "@streamdown/math": "latest",
    "@streamdown/mermaid": "latest",
    "ai": "^7.0.137",
    "ansi-to-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "latest",
    "lucide-react": "^1.55.0",
    "motion": "latest",
    "nanoid": "latest",
    "next": "^16.4.0",
    "radix-ui": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "latest",
    "streamdown": "latest",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "latest",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
