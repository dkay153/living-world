{
  "name": "living-world",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node scripts/test.js",
    "backup": "node scripts/backup.js",
    "steward:status": "node scripts/steward-status.js",
    "steward:once": "node scripts/steward-status.js --once",
    "admin:open": "node scripts/admin-open.js",
    "admin:prepare": "node scripts/admin-open.js --prepare",
    "godot:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/godot-check.ps1",
    "contracts:check": "node scripts/validate-contracts.js",
    "lab:micro": "node scripts/micro-world-lab.js",
    "lab:full": "npm test && npm run lab:micro"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
